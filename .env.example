# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase browser client settings.
# Use the publishable/anon key only. Never put a service role key in Vite env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# PhonePe Developer Platform Settings
# Mode: 'sandbox' (testing with PGTESTPAYUAT) or 'production' (live merchant MID)
VITE_PHONEPE_ENV=sandbox
VITE_PHONEPE_MERCHANT_ID=PGTESTPAYUAT
VITE_PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
VITE_PHONEPE_SALT_INDEX=1
